{
  "name": "oldways",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate-provenance.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:import": "tsx scripts/import-rigveda.ts",
    "db:import:griffith": "tsx scripts/import-griffith-rigveda.ts",
    "db:prepare:vercel": "tsx scripts/prepare-vercel-db.ts",
    "db:fetch-rv": "tsx scripts/fetch-rigveda-source.ts --skip-if-present",
    "db:fetch-griffith": "tsx scripts/fetch-griffith-wikisource.ts --skip-if-present",
    "db:validate": "tsx scripts/validate-provenance.ts",
    "db:compare-rv": "tsx scripts/compare-rigveda-sources.ts",
    "test": "vitest run",
    "vercel-build": "npm run db:prepare:vercel && DATABASE_URL=file:./dev.db npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sanskrit-coders/sanscript": "^1.2.8",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
